# RemoteView laptop configuration
# Copy this file to .env (never commit .env) or set these as system variables.

# Port the laptop server listens on
RV_PORT=8756

# Seconds a pairing code stays valid
RV_PAIRING_TTL=300

# Days before a paired device must re-pair
RV_SESSION_TTL_DAYS=30

# Default streaming limits (phones may lower these automatically)
RV_FPS=12
RV_QUALITY=60
RV_SCALE=1.0

# Gemini AI — up to 3 API keys from different Google accounts.
# Key 1 should be your best account (PRO if you have one) — it's tried first.
# Leave empty to disable AI features — screen sharing works without it.
# Get free API keys: https://aistudio.google.com/apikey
# GEMINI_API_KEY_1=your_pro_account_key_here
# GEMINI_API_KEY_2=your_normal_account_key_here
# GEMINI_API_KEY_3=your_normal_account_key_here
# GEMINI_MODEL=gemini-3.6-flash

